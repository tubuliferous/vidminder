{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VidMinder",
  "version": "0.2.14",
  "identifier": "com.vidminder.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VidMinder",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "resources": ["runtime/**/*"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["http", "https"]
      }
    }
  }
}
