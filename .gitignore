# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Sidecar binaries — populated per platform by scripts/install-sidecar.mjs
# locally, or by the CI workflow before each build.
src-tauri/binaries/

# Embedded Python runtime (relocatable CPython + yt-dlp), bundled as a Tauri
# resource. Populated per platform by scripts/install-sidecar.mjs / CI.
src-tauri/runtime/

# Local dev icon overrides. Populated by `npx tauri icon <your.png> --output
# src-tauri/icons-dev`. Not part of the production build — used only by
# `npm run tauri:dev` via tauri.conf.dev.json.
src-tauri/icons-dev/*
!src-tauri/icons-dev/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cloudflare (web/)
.wrangler
.dev.vars
